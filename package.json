{
  "name": "tilde-harness-sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "biome check . && pnpm typecheck",
    "format": "biome check --write .",
    "sync:openapi": "tsx scripts/sync-openapi.ts",
    "validate:openapi": "tsx scripts/validate-openapi-surface.ts",
    "sdk:refresh": "pnpm sync:openapi && pnpm validate:openapi && pnpm -r build && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.2",
    "@types/node": "^24.3.0",
    "openapi-typescript": "^7.10.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
