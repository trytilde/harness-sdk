{
  "name": "tilde-harness-sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter '@trytilde/harness-sdk...' build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "biome check . && pnpm typecheck",
    "format": "biome check --write .",
    "release:publish": "node scripts/publish-packages.mjs",
    "release:smoke": "node scripts/smoke-test-packages.mjs",
    "release:validate": "node scripts/validate-packages.mjs",
    "sync:openapi": "tsx scripts/sync-openapi.ts",
    "validate:openapi": "tsx scripts/validate-openapi-surface.ts",
    "sdk:refresh": "pnpm sync:openapi && pnpm validate:openapi && pnpm -r build && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.2",
    "@hey-api/client-fetch": "0.13.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "ai": "^6.0.197",
    "happy-dom": "^20.10.3",
    "openapi-typescript": "^7.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.8"
  }
}
