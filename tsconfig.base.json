{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@tilde/harness-sdk": ["packages/core/src/index.ts"],
      "@tilde/harness-sdk-react": ["packages/react/src/index.ts"],
      "@tilde/harness-sdk-vercel-ai-node": [
        "packages/vercel-ai-node/src/index.ts"
      ],
      "@tilde/harness-sdk-vercel-ai-react": [
        "packages/vercel-ai-react/src/index.ts"
      ]
    }
  }
}
