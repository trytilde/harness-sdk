{
  "name": "@trytilde/harness-sdk",
  "version": "0.1.2",
  "description": "Core TypeScript SDK for Tilde Harness APIs.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trytilde/harness-sdk.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/trytilde/harness-sdk#readme",
  "bugs": {
    "url": "https://github.com/trytilde/harness-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts"
  },
  "dependencies": {
    "@trytilde/api-client": "^0.1.2",
    "nice-grpc": "^2.1.16"
  },
  "devDependencies": {}
}
