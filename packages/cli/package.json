{
  "name": "@trytilde/cli",
  "version": "0.0.0",
  "description": "Tilde command line interface.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "tilde": "dist/cli.js",
    "t": "dist/cli.js"
  },
  "exports": {
    ".": {
