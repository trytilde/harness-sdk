{
  "name": "@trytilde/cli",
  "version": "0.1.0",
  "description": "Tilde command line interface.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trytilde/harness-sdk.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/trytilde/harness-sdk#readme",
  "bugs": {
    "url": "https://github.com/trytilde/harness-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "tilde": "dist/cli.js",
    "t": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && chmod +x dist/cli.js",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts test"
  },
  "dependencies": {
    "@trytilde/harness-sdk": "^0.1.2",
    "ink": "^7.1.0",
    "react": "^19.2.7",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17"
  }
}
